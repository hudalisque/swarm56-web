[Unit]
Description=Swarm56 강제 재클립 에이전트 1회 실행 (백오피스 "강제 갱신" 트리거, dedup 무시)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/swarm56
# v5 경로는 agent.env가 단일 소스로 제공. 낡은 vault/site.db inline 은 두지 않는다(KNOWN_ISSUES.md 참조).
EnvironmentFile=/etc/swarm56/agent.env
Environment=SWARM56_THUMBNAIL_DIR=/var/lib/swarm56/web/thumbnails
Environment=SWARM56_IG_TOKEN_FILE=/var/lib/swarm56/ig_token
# SWARM56_FORCE=1 → 볼트 md 존재(dedup) 스킵을 무시하고 재수집·덮어쓰기(원본 수정 반영)
Environment=SWARM56_FORCE=1
ExecStart=/opt/swarm56/agent-venv/bin/python -m agent.main
ExecStartPost=/bin/rm -f /var/lib/swarm56/triggers/force.now
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
